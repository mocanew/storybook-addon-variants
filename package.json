{
  "name": "storybook-addon-variants",
  "version": "0.2.0",
  "description": "Show all variants of a component in a grid",
  "keywords": [
    "storybook-addon",
    "props",
    "api",
    "combinations",
    "mixed",
    "combined grid"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/itaditya/storybook-addon-variants"
  },
  "author": "itaditya",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./preset": "./dist/preset.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "*.js",
    "*.d.ts"
  ],
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('./dist', { recursive: true, force: true })\"",
    "build": "tsup",
    "build:watch": "npm run build -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck",
    "storybook": "storybook dev -p 6006",
    "start": "concurrently \"npm run build:watch\" \"npm run storybook -- --quiet\"",
    "build-storybook": "npm run build && storybook build",
    "prerelease": "zx scripts/prepublish-checks.mjs",
    "release": "npm run build && auto shipit"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.0.0",
    "@types/node": "^20.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "auto": "^10.3.0",
    "boxen": "^5.0.1",
    "concurrently": "^6.2.0",
    "dedent": "^0.7.0",
    "prettier": "^3.6.0",
    "prop-types": "^15.7.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^10.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "zx": "^8.8.0"
  },
  "peerDependencies": {
    "storybook": "^10.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "bundler": {
    "previewEntries": [
      "src/preview.ts",
      "src/index.ts"
    ],
    "nodeEntries": [
      "src/preset.ts"
    ]
  },
  "storybook": {
    "displayName": "Variants Addon",
    "supportedFrameworks": [
      "react"
    ],
    "icon": "https://user-images.githubusercontent.com/321738/63501763-88dbf600-c4cc-11e9-96cd-94adadc2fd72.png"
  },
  "dependencies": {
    "cartesian": "^1.0.1"
  },
  "auto": {
    "onlyPublishWithReleaseLabel": true
  }
}
